  month     =  sep,
  year      =  2008,
  language  = "en"
}

@ARTICLE{Wilson2007-kk,
  title     = "Consequences of thermal acclimation for the mating behaviour and
               swimming performance of female mosquito fish",
  author    = "Wilson, Robbie S and Condon, Catriona H L and Johnston, Ian A",
  journal   = "Philos. Trans. R. Soc. Lond. B Biol. Sci.",
