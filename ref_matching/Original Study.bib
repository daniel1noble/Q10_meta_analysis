  month     =  dec,
  year      =  2006,
  language  = "en"
}

@ARTICLE{Lucassen2006-wa,
  title     = "Mitochondrial mechanisms of cold adaptation in cod (Gadus morhua
               {L}.) populations from different climatic zones",
  author    = "Lucassen, M and Koschnick, N and Eckerle, L G and Pörtner, H-O",
