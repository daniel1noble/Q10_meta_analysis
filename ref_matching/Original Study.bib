@ARTICLE{Hochscheid2004-pe,
  title     = "Long-term cold acclimation leads to high {Q10} effects on oxygen
               consumption of loggerhead sea turtles Caretta caretta",
  author    = "Hochscheid, Sandra and Bentivegna, Flegra and Speakman, John R",
  journal   = "Physiol. Biochem. Zool.",
